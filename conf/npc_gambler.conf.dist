[worldserver]

########################################
# Asmongold <Deathroll Addict> (Tofu Worldview fork of mod-npc-gambler)
########################################
#
# Values load at server start and again on ".reload config".
# Money amounts are in copper unless the key says gold (1g = 10000 copper, 1s = 100 copper).

#
#   Asmongold.Gamba.Bet1 to Bet4
#       The four Gamba bets, in copper.
#       Default: 1000 (10s), 10000 (1g), 250000 (25g), 1000000 (100g)
#

Asmongold.Gamba.Bet1 = 1000
Asmongold.Gamba.Bet2 = 10000
Asmongold.Gamba.Bet3 = 250000
Asmongold.Gamba.Bet4 = 1000000

#
#   Asmongold.Gamba.WinMax
#       A roll from 1 to this value wins. A roll of 100 is the jackpot. Everything else loses.
#       49 gives the player a 1% edge (1.01x stake returned on average); 48 gives the house a 1% edge (0.99x). If you change it, also update the Gamba text (npc_text 900021) in the module SQL.
#       Default: 49
#

Asmongold.Gamba.WinMax = 49

#
#   Asmongold.Gamba.WinMultiplier, Asmongold.Gamba.JackpotMultiplier
#       Total paid back on a win or a jackpot, as a multiple of the stake (the stake is taken when the bet is placed).
#       Default: 2, 3
#

Asmongold.Gamba.WinMultiplier = 2
Asmongold.Gamba.JackpotMultiplier = 3

#
#   Asmongold.Gamba.PityLosses, Asmongold.Gamba.PityBonus
#       After PityLosses Gamba losses in a row (counted across all players), the next losing roll is lowered by PityBonus. The pity is used up after that one roll; any win also resets the count.
#       Default: 5, 25
#

Asmongold.Gamba.PityLosses = 5
Asmongold.Gamba.PityBonus = 25

#
#   Asmongold.Deathroll.Bet1 to Bet4
#       The four Deathroll bets, in gold. A win pays back 2x the bet. Standard mode rolls to 10x the bet.
#       Default: 10, 100, 500, 1000
#

Asmongold.Deathroll.Bet1 = 10
Asmongold.Deathroll.Bet2 = 100
Asmongold.Deathroll.Bet3 = 500
Asmongold.Deathroll.Bet4 = 1000

#
#   Asmongold.Deathroll.CustomMin, Asmongold.Deathroll.CustomMax
#       Allowed range for the number typed in Custom mode.
#       Default: 1, 1000000
#

Asmongold.Deathroll.CustomMin = 1
Asmongold.Deathroll.CustomMax = 1000000

#
#   Asmongold.RPS.WinCopper
#       Copper paid for a Rock-Paper-Scissors win.
#       Default: 1
#

Asmongold.RPS.WinCopper = 1

#
#   Asmongold.Barker.Enable
#       Asmongold says a random line from Asmongold.Barker.Messages every few minutes.
#       Enable: 1, Disable: 0
#       Default: 1
#

Asmongold.Barker.Enable = 1

#
#   Asmongold.Barker.IntervalMin, Asmongold.Barker.IntervalMax
#       Seconds between lines, picked at random in this range. Minimum 10.
#       Default: 60, 180
#

Asmongold.Barker.IntervalMin = 60
Asmongold.Barker.IntervalMax = 180

#
#   Asmongold.Barker.FireworkChance
#       Percent chance (0 to 100) that a barker line also sets off the upstream firework visual (spell 44940) on Asmongold.
#       Default: 0
#

Asmongold.Barker.FireworkChance = 0

#
#   Asmongold.Barker.Messages
#       Barker lines separated by ";". Do not use ";" or "|" inside a line.
#       Leave empty to use the 10 built-in Asmongold lines, each with its own emote. A line that matches a built-in line exactly keeps its emote; any other line gets a random emote.
#       Default: ""
#

Asmongold.Barker.Messages = ""
